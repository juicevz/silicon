# Public configuration. Private signing keys stay out of the repository.
PRIVY_APP_ID=
DATA_DIR=../data
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com/
EXPLORER_URL=https://robinhoodchain.blockscout.com
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
DEV_WALLET_ADDRESS=0xf7654bf2e3139d059Db1f015897766EA3A2aEfBE
# Official SILICON token on Robinhood Chain 4663. Ownership remains optional.
TOKEN_ADDRESS=0x389860f1f8eaba66d8b2925923a40b739a67e6b0
MARKET_ADDRESS=
MARKET_START_BLOCK=0
# JSON array of additional H100 vault rounds; current MARKET_ADDRESS is included automatically.
VAULT_ROUND_ADDRESSES=[]
TRADING_ENABLED=false
COLLECTION_INTERVAL=180
SOURCE_STALE_SECONDS=10800
FEE_BPS=100

# Compute stays disabled until its server credential and private limits are configured.
# OPENROUTER_API_KEY belongs in a secret manager or an ignored, restricted .env.compute.
COMPUTE_ENABLED=false
# Also validates wallet holder-tool sign-in and writes. Set to the public site origin.
COMPUTE_ORIGIN=https://siliconmarkets.io
COMPUTE_SPEND_LIMIT_USD=0
COMPUTE_GRANT_USD=0
COMPUTE_GRANT_POOL_USD=0
COMPUTE_MAX_ACCOUNTS=50
COMPUTE_OPEN_ENROLLMENT=false
COMPUTE_ALLOWED_WALLETS=[]

# Optional browser push. Monitoring and the server inbox work without these.
# Generate once outside Git with scripts/init_alert_push.py, then load alerts.env.
ALERTS_VAPID_PUBLIC_KEY=
# ALERTS_VAPID_PRIVATE_KEY_PATH=/absolute/private/silicon-alerts/vapid.pem
