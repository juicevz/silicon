# Copy to .env at the repository root for local development.
# Values here are public defaults or empty placeholders, never credentials.
# Keep trading disabled until the configured market is funded and verified.
# Private signing material belongs outside Git and browser configuration.

DATA_DIR=../data
RPC_URL=https://rpc.mainnet.chain.robinhood.com/
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Token contract for this checkpoint. Leave blank until configured.
TOKEN_ADDRESS=
# Configure only a reviewed market contract; blank keeps it unconfigured.
MARKET_ADDRESS=
MARKET_START_BLOCK=0
# JSON array of additional reviewed vault-round addresses.
VAULT_ROUND_ADDRESSES=[]
PRIVY_APP_ID=
COLLECTION_INTERVAL=180
SOURCE_STALE_SECONDS=10800
FEE_BPS=100
TRADING_ENABLED=false
DEV_WALLET_ADDRESS=
